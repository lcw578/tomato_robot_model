    def read_matrix_from_txt(self,file_path):
        """
        从txt文件读取数据并转换为4x4 numpy矩阵
        
        Args:
            file_path (str): 文件路径
        
        Returns:
            numpy.ndarray: 4x4矩阵
        """
        # 读取文件内容
        with open(file_path, 'r') as file:
            content = file.read().strip()
        
        # 按行分割
        lines = content.split('\n')
        
        # 创建4x4矩阵
        matrix = np.zeros((4, 4))
        
        # 解析每行数据
        for i, line in enumerate(lines):
            # 按逗号分割数值
            values = line.split(',')
            for j, value in enumerate(values):
                # 转换为浮点数并填入矩阵
                matrix[i, j] = float(value)
        
        return matrix
    # 以下是从原始代码移植的匹配算法函数
    @staticmethod
    def calculate_iou(box1, box2):
        """精确计算两个矩形框的交并比"""
        x_left = max(box1[0], box2[0])
        y_top = max(box1[1], box2[1])
        x_right = min(box1[2], box2[2])
        y_bottom = min(box1[3], box2[3])

        if x_right < x_left or y_bottom < y_top:
            return 0.0

        intersection_area = (x_right - x_left) * (y_bottom - y_top)
        box1_area = (box1[2] - box1[0]) * (box1[3] - box1[1])
        box2_area = (box2[2] - box2[0]) * (box2[3] - box2[1])
        union_area = box1_area + box2_area - intersection_area
        return intersection_area / union_area if union_area > 0 else 0

    @staticmethod
    def calculate_iou_stems(box1, box2):
        """精确计算两个矩形框的交并比（以box1为基准）"""
        x_left = max(box1[0], box2[0])
        y_top = max(box1[1], box2[1])
        x_right = min(box1[2], box2[2])
        y_bottom = min(box1[3], box2[3])

        if x_right < x_left or y_bottom < y_top:
            return 0.0

        intersection_area = (x_right - x_left) * (y_bottom - y_top)
        box1_area = (box1[2] - box1[0]) * (box1[3] - box1[1])
        return intersection_area / box1_area if box1_area > 0 else 0

    @staticmethod
    def calculate_gap(boxA, boxB):
        """通用间隙计算函数"""
        # X方向间隙
        if boxA[2] <= boxB[0]:  # A在B左边
            x_gap = boxB[0] - boxA[2]
        elif boxB[2] <= boxA[0]:  # B在A左边
            x_gap = boxA[0] - boxB[2]
        else:
            x_gap = -1

        # Y方向间隙
        if boxA[3] <= boxB[1]:  # A在B上边
            y_gap = boxB[1] - boxA[3]
        elif boxB[3] <= boxA[1]:  # B在A上边
            y_gap = boxA[1] - boxB[3]
        else:
            y_gap = -1

        return x_gap, y_gap

    @staticmethod
    def can_intersect_after_shift(box1, box2, img_width, img_height, 
                                 x_shift_ratio=0.15, y_shift_ratio=0.15,
                                 iou_threshold=0):
        """判断是否可以通过平移产生有效交集（强制stem在下边沿上方）"""
        if box1[3] > box2[3]:  # stem底部必须<=tomato底部
            return False, 0

        original_iou = XCRobotMainControlNode.calculate_iou_stems(box1, box2)
        if original_iou > iou_threshold:
            return True, original_iou

        x_gap, y_gap = XCRobotMainControlNode.calculate_gap(box1, box2)
        x_threshold = img_width * x_shift_ratio
        y_threshold = img_height * y_shift_ratio
        threshold_min = min(x_threshold, y_threshold)

        best_iou = 0
        # 横向平移判断
        if 0 <= x_gap <= threshold_min:
            box1_shifted = [box1[0] + x_gap, box1[1], box1[2] + x_gap, box1[3]]
            box2_shifted = [box2[0] - x_gap, box2[1], box2[2] - x_gap, box2[3]]
            best_iou = max(best_iou, XCRobotMainControlNode.calculate_iou_stems(box1_shifted, box2_shifted))

        # 纵向平移判断
        if 0 <= y_gap <= threshold_min:
            box1_shifted = [box1[0], box1[1] + y_gap, box1[2], box1[3] + y_gap]
            box2_shifted = [box2[0], box2[1] - y_gap, box2[2], box2[3] - y_gap]
            best_iou = max(best_iou, XCRobotMainControlNode.calculate_iou_stems(box1_shifted, box2_shifted))

        return (best_iou > iou_threshold), best_iou

    def combine_boxes(self, img, stems, tomatos, img_size, iou_threshold=0):
        """智能组合框选择（保持stem位置条件）"""
        # self.get_logger().info('进入了combine_boxes程序----')
        
        matched_stems = set()
        matched_tomatos = set()
        matched_pairs = []  # 存储匹配的果梗和番茄对（包含完整6个元素）
        matched_rectangles = [] #存储匹配结果 x1 y1 x2 y2
        
        # 遍历所有果梗
        for s_idx, stem in enumerate(stems):
            if s_idx in matched_stems:
                continue

            best_tomato = None
            best_tomato_idx = None
            best_iou = 0
            stem_bottom = stem[3]

            # 遍历所有番茄
            for t_idx, tomato in enumerate(tomatos):
                if t_idx in matched_tomatos or stem_bottom > (tomato[1]+tomato[3])/2:
                    continue

                current_iou = self.calculate_iou_stems(stem, tomato)

                if current_iou > best_iou and current_iou > iou_threshold:
                    best_iou = current_iou
                    best_tomato = tomato
                    best_tomato_idx = t_idx

            # 次选可平移匹配的番茄
            if best_tomato is None:
                for t_idx, tomato in enumerate(tomatos):
                    if t_idx in matched_tomatos or stem_bottom > (tomato[1]+tomato[3])/2:
                        continue

                    can_shift, shifted_iou = self.can_intersect_after_shift(
                        stem, tomato, img_size[1], img_size[0], iou_threshold=iou_threshold
                    )
                    if can_shift and shifted_iou > best_iou:
                        best_iou = shifted_iou
                        best_tomato = tomato
                        best_tomato_idx = t_idx

            # 绘制组合框并记录匹配
            if best_tomato is not None:
                # 将坐标转换为整数
                x1 = int(min(stem[0], best_tomato[0]))
                y1 = int(min(stem[1], best_tomato[1]))
                x2 = int(max(stem[2], best_tomato[2]))
                y2 = int(max(stem[3], best_tomato[3]))
                
                # 确保坐标在图像范围内
                h, w = img.shape[:2]
                x1 = max(0, min(x1, w-1))
                y1 = max(0, min(y1, h-1))
                x2 = max(0, min(x2, w-1))
                y2 = max(0, min(y2, h-1))
                
                cv2.rectangle(img, (x1, y1), (x2, y2), (255, 0, 0), 10)
                matched_rectangles.append([x1, y1, x2, y2])
                
                # 添加到匹配集合
                matched_stems.add(s_idx)
                matched_tomatos.add(best_tomato_idx)
                
                # 记录完整的果梗和番茄信息（包含所有6个元素）
                matched_pairs.append((stem, best_tomato))
        # self.get_logger().info(f'准备离开combine_boxes程序,匹配数量为{len(matched_pairs)}----')
                
        # cv2.imshow("Matched Boxes", img)
        # cv2.waitKey(0)
        # cv2.destroyAllWindows()
        return img, matched_pairs, matched_rectangles

    def camera_info_callback(self, msg):
        """相机内参回调函数"""
        if self.intrinsics_ready:
            return
        try:
            with self.camera_matrix_lock:
                self.intrinsics = rs2.intrinsics()
                self.intrinsics.width = msg.width
                self.intrinsics.height = msg.height
                self.intrinsics.ppx = msg.k[2]
                self.intrinsics.ppy = msg.k[5]
                self.intrinsics.fx = msg.k[0]
                self.intrinsics.fy = msg.k[4]
                if msg.distortion_model == 'plumb_bob':
                    self.intrinsics.model = rs2.distortion.brown_conrady
                elif msg.distortion_model == 'equidistant':
                    self.intrinsics.model = rs2.distortion.kannala_brandt4
                self.intrinsics.coeffs = [i for i in msg.d]
                self.intrinsics_ready = True
                self.is_real_camera_data = True
                #取消订阅
                self.destroy_subscription(self.camera_info_sub)
                self.camera_info_sub = None
                self.get_logger().info(f"已获取相机内参")

        except Exception as e:
            self.get_logger().error(f"处理相机内参时出错: {e},使用默认内参")
            self.set_default_intrinsics()
    
    def set_default_intrinsics(self):
        with self.camera_matrix_lock:
            
            self.intrinsics = rs2.intrinsics()
            self.intrinsics.width = 1280
            self.intrinsics.height = 720
            self.intrinsics.fx = 904.136
            self.intrinsics.fy = 904.541 
            self.intrinsics.ppx = 646.646
            self.intrinsics.ppy = 352.313
            self.intrinsics.model = rs2.distortion.brown_conrady
            self.intrinsics.coeffs = [0.170956, -0.525839, -0.000931794, 0.000153935, 0.486463]
            
            # 深度缩放因子和偏移量
            self.depth_scale = 0.00025
            self.depth_offset = 0.00025
            self.is_real_camera_data = False
            self.intrinsics_ready = False

    def wait_for_keypress(self):
        """
        等待键盘按键输入
        按'd'继续执行，按'q'退出程序
        """
        self.get_logger().info('等待用户按键...')
        # 保存原始终端设置
        old_settings = termios.tcgetattr(sys.stdin)
        try:
            # 设置终端为非阻塞模式
            tty.setraw(sys.stdin.fileno())
            while True:
                # 非阻塞读取
                ready, _, _ = select.select([sys.stdin], [], [], 0.1)  # 0.1秒超时
                if ready:
                    key = sys.stdin.read(1)
                    if key.lower() == 'd':  # 接受大写和小写D
                        self.get_logger().info('收到"d"键，继续执行...')
                        break
                    elif key.lower() == 'q':  # 接受大写和小写Q
                        self.get_logger().info('收到"q"键，退出程序...')
                        sys.exit(0)
                # 短暂休眠以减少CPU占用
                time.sleep(0.01)
        except Exception as e:
            self.get_logger().error(f'键盘监听出现错误: {e}')
        finally:
            # 恢复终端设置
            termios.tcsetattr(sys.stdin, termios.TCSADRAIN, old_settings)

def main(args=None):
    rclpy.init(args=args)
    # rclpy.init(args=args)
    # 显式设置日志级别为DEBUG
    rclpy.logging.set_logger_level('xc_robot_main_control_node', rclpy.logging.LoggingSeverity.DEBUG)
    node = XCRobotMainControlNode()
    # 使用多线程执行器以更好地处理订阅和服务
    executor = MultiThreadedExecutor(num_threads=4)
    executor.add_node(node)
    try:
        executor.spin()
    finally:
        # node.get_logger().info(f"33333333333")
        node.kill_old_camera()

        executor.remove_node(node)
        node.destroy_node()
        rclpy.shutdown()

if __name__ == '__main__':
    main()
